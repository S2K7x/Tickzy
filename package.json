{
  "name": "tickzy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:migrate": "pnpm --filter @tickzy/db migrate",
    "secrets": "secretlint --maskSecrets \"**/*\" && node scripts/check-private-keys.mjs",
    "audit:deps": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@types/node": "22.20.5",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "4.2.1",
    "prettier": "^3.6.0",
    "secretlint": "13.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
