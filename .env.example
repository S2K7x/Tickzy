# Owner connection: runs migrations (needs CREATEROLE).
DATABASE_OWNER_URL=postgres://tickzy_owner:tickzy@localhost:5432/tickzy_dev
# App connection: runtime role WITHOUT BYPASSRLS (created by migrations; set its password in dev with: ALTER ROLE tickzy_app PASSWORD 'tickzy_app').
DATABASE_URL=postgres://tickzy_app:tickzy_app@localhost:5432/tickzy_dev
PORT=3000
LOG_LEVEL=info
# Never true in production (server refuses to start).
AUTH_DEV_MODE=true
# Client IP for rate limits: "false" = socket address (default). Behind a load balancer set the hop count (e.g. 1)
# or the proxy addresses/CIDRs. "true" is refused (it would let clients spoof X-Forwarded-For).
TRUST_PROXY=false
# Requests per minute: per API token or signed-in user; per client IP (all requests); per IP on sign-in/invite endpoints.
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_IP_PER_MIN=1200
RATE_LIMIT_AUTH_PER_MIN=20
# Google / Microsoft sign-in (optional; see docs/operations/sign-in-providers.md). Leave empty to hide the buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Inbound email via Postmark (optional; T-302a, ADR-033). Set all three or none. The webhook URL configured in
# Postmark is https://<POSTMARK_INBOUND_USER>:<POSTMARK_INBOUND_PASSWORD>@<api host>/ingest/email
# INBOUND_EMAIL_DOMAIN=inbound.example.com
# POSTMARK_INBOUND_USER=postmark-inbound
# POSTMARK_INBOUND_PASSWORD=<at least 24 random characters>
