# Owner connection: runs migrations (needs CREATEROLE).
DATABASE_OWNER_URL=postgres://tickzy_owner:tickzy@localhost:5432/tickzy_dev
# App connection: runtime role WITHOUT BYPASSRLS (created by migrations; set its password in dev with: ALTER ROLE tickzy_app PASSWORD 'tickzy_app').
DATABASE_URL=postgres://tickzy_app:tickzy_app@localhost:5432/tickzy_dev
PORT=3000
LOG_LEVEL=info
# Never true in production (server refuses to start).
AUTH_DEV_MODE=true
